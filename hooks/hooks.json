{
  "description": "task-loop: index each session's transcript for the dashboard, write the handoff before a compaction and give it back after, refuse a pkill/killall.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {"type": "command", "command": "uv run --quiet --script \"${CLAUDE_PLUGIN_ROOT}/hooks/hook.py\" session-start", "timeout": 20}
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {"type": "command", "command": "uv run --quiet --script \"${CLAUDE_PLUGIN_ROOT}/hooks/hook.py\" precompact", "timeout": 20}
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {"type": "command", "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/hook.py\" pretool", "timeout": 3}
        ]
      }
    ]
  }
}
