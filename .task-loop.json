{
  "engine": {
    "owner_author": "Denis Tomilin",
    "land": [
      "git",
      "push",
      "origin",
      "HEAD:main"
    ],
    "pick_label": "auto",
    "needs_info_label": "needs-info",
    "checks": [
      {
        "id": "suite",
        "argv": [
          "just",
          "gate"
        ],
        "group": "tests",
        "run": "gate",
        "closure_cmd": [
          "python3",
          "dev/affected.py",
          "--closure"
        ]
      }
    ]
  }
}
