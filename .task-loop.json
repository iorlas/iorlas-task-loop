{
  "engine": {
    "owner_author": "Denis Tomilin",
    "land": [
      "git",
      "push",
      "origin",
      "HEAD:main"
    ],
    "pick_label": "auto",
    "needs_info_label": "needs-info",
    "checks": [
      {
        "id": "suite",
        "argv": [
          "uv",
          "run",
          "--script",
          "dev/suite.py"
        ],
        "group": "tests",
        "run": "gate"
      }
    ]
  }
}
