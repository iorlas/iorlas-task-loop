[importlinter]
root_packages =
    taskloop
    urllib
    http
    multiprocessing
include_external_packages = True

[importlinter:contract:entry-depends-on-cli]
name = The module entry delegates to the CLI; the CLI never imports the entry
type = layers
layers =
    taskloop.__main__
    taskloop.cli

[importlinter:contract:no-runtime-mechanisms]
name = The foundation has no direct network or process mechanisms
type = forbidden
source_modules = taskloop
forbidden_modules =
    urllib
    http
    multiprocessing
allow_indirect_imports = True
