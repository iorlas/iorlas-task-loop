[importlinter]
root_packages =
    taskloop
    process_lock
    urllib
    http
    multiprocessing
include_external_packages = True

[importlinter:contract:main-depends-on-cli]
name = The `tl` module entry (`__main__`) delegates to the CLI; the CLI delegates to the step surface; neither imports upward
type = layers
layers =
    taskloop.__main__
    taskloop.cli
    taskloop.cli_step
    taskloop.cli_composition

[importlinter:contract:cli-never-imports-the-attempt-entry]
name = The command surface, its operations, their JSON shape and the machine config never import the attempt entry process
type = forbidden
source_modules =
    taskloop.cli
    taskloop.cli_step
    taskloop.cli_composition
    taskloop.exit_codes
    taskloop.step_guide
    taskloop.step_render
    taskloop.operations
    taskloop.attempt_status
    taskloop.round
    taskloop.round_log
    taskloop.selection
    taskloop.result_data
    taskloop.machine_config
    taskloop.rounds
    taskloop.rounds_lock
    taskloop.interrupts
forbidden_modules =
    taskloop.attempt_entry

[importlinter:contract:entry-never-imports-the-command-surface]
name = The attempt entry process imports no command surface, operations or machine config (its import closure stays small)
type = forbidden
source_modules =
    taskloop.attempt_entry
    taskloop.composition
    taskloop.git_views
    taskloop.agent_credentials
    taskloop.owned_processes
    taskloop.slot_files
    taskloop.tracker_client
    taskloop.slot_env
    taskloop.access
forbidden_modules =
    taskloop.cli
    taskloop.cli_step
    taskloop.cli_composition
    taskloop.exit_codes
    taskloop.step_guide
    taskloop.step_render
    taskloop.operations
    taskloop.attempt_status
    taskloop.round
    taskloop.result_data
    taskloop.machine_config
    taskloop.rounds
    taskloop.interrupts

[importlinter:contract:no-runtime-mechanisms]
name = The foundation has no direct network or process mechanisms
type = forbidden
source_modules = taskloop
forbidden_modules =
    urllib
    http
    multiprocessing
allow_indirect_imports = True

[importlinter:contract:process-lock-owners]
name = Only slot custody and the rounds lock import the process lock library
type = forbidden
source_modules = taskloop
forbidden_modules = process_lock
ignore_imports =
    taskloop.slot_lock -> process_lock
    taskloop.rounds_lock -> process_lock

[importlinter:contract:one-signal-owner]
name = Only the rounds process's SIGINT handler imports signal
type = forbidden
source_modules = taskloop
forbidden_modules = signal
ignore_imports =
    taskloop.interrupts -> signal

[importlinter:contract:one-step-kind-owner]
name = Only the step kinds (`steps`) import a step kind's own module; the machinery reaches each through `steps.kind`
type = protected
protected_modules =
    taskloop.plan_step
    taskloop.implement_step
allowed_importers = taskloop.steps

[importlinter:contract:profile-is-domain]
name = The repository profile reader is domain: no command surface, composition (or the real ports it wires), store or Git library (Git enters through its port)
type = forbidden
source_modules = taskloop.profile
forbidden_modules =
    taskloop.cli
    taskloop.cli_step
    taskloop.cli_composition
    taskloop.composition
    taskloop.git_views
    taskloop.agent_credentials
    taskloop.owned_processes
    taskloop.slot_files
    taskloop.tracker_client
    taskloop.exit_codes
    taskloop.step_render
    taskloop.result_data
    taskloop.operations
    taskloop.attempt_entry
    git_porcelain
    sqlite_store
    beads_client
