# The architecture rules (was tests/gate_rules.py layer_problems / placement_problems and the contracts and ports rule files).
# Run by `just rules` with src/ on PYTHONPATH. stdlib modules that are one file (subprocess, socket, threading) cannot be root packages
# here (urllib, http, multiprocessing, re are packages): their ban is ruff TID251 (packages/kernel/src/tlkernel/ruff.toml, src/taskloop/stores/ruff.toml). "delegate" is banned by TID251 in ruff.toml.
[importlinter]
root_packages =
    taskloop
    delegate
    tldash
    tlkernel
    tlartifacts
    tlgate
    tlwork
    tlslots
    tlasks
    tlrelease
    tlpipeline
    msgspec
    re
    urllib
    http
    multiprocessing
    stream_proc
include_external_packages = True

[importlinter:contract:layers]
name = Layers: cli/hook > app > stores > domain/adapters > contracts
type = layers
layers =
    taskloop.cli | taskloop.hook
    taskloop.app
    taskloop.stores
    taskloop.domain | taskloop.adapters
    tlkernel

[importlinter:contract:forbidden-regex]
name = import re only in adapters and domain matchers
type = forbidden
source_modules =
    taskloop
    tldash
    delegate
forbidden_modules = re
allow_indirect_imports = True
ignore_imports =
    taskloop.adapters.** -> re
    taskloop.domain.**.matchers -> re
    delegate.domain.**.matchers -> re

[importlinter:contract:contracts-no-network-or-processes]
name = contracts never imports urllib, http or multiprocessing
type = forbidden
source_modules = tlkernel
forbidden_modules =
    urllib
    http
    multiprocessing
allow_indirect_imports = True

# Workspace tests enforce their declared dependencies in tests/rules/test_package_tests.py (TESTISO).
[importlinter:contract:kernel-imports-nothing-of-ours]
name = the kernel (tlkernel) imports no application or stage package
type = forbidden
source_modules = tlkernel
forbidden_modules =
    taskloop
    tldash
    delegate
    tlasks
allow_indirect_imports = True

[importlinter:contract:kernel-core-is-a-leaf]
name = the kernel core (wire, ids, enums, paths, env, envvars, identity, bead) imports no other tlkernel module (docs/design/architecture-vertical.md K1)
type = forbidden
source_modules =
    tlkernel.wire
    tlkernel.ids
    tlkernel.enums
    tlkernel.paths
    tlkernel.env
    tlkernel.envvars
    tlkernel.identity
    tlkernel.bead
forbidden_modules =
    tlkernel.*
allow_indirect_imports = True
ignore_imports =
    # The core's own edges (paths -> env, ids; env -> envvars, ids; identity -> paths, wire; bead -> ids, wire). A new one is a decision, not a drift.
    tlkernel.paths -> tlkernel.env
    tlkernel.paths -> tlkernel.ids
    tlkernel.env -> tlkernel.envvars
    tlkernel.env -> tlkernel.ids
    tlkernel.identity -> tlkernel.paths
    tlkernel.identity -> tlkernel.wire
    tlkernel.bead -> tlkernel.ids
    tlkernel.bead -> tlkernel.wire

[importlinter:contract:hot-hook-path-is-light]
name = the PreToolUse and git pre-push hooks import no msgspec and no record model
type = forbidden
source_modules =
    taskloop.hook.main
    taskloop.hook.pretool
    taskloop.hook.rules
    taskloop.hook.prepush
forbidden_modules =
    msgspec
    tlkernel
    taskloop.app
    taskloop.adapters
    taskloop.stores
    taskloop.domain

[importlinter:contract:msgspec-in-contracts-only]
name = only tlkernel imports msgspec
type = forbidden
source_modules =
    taskloop
    tldash
forbidden_modules = msgspec
allow_indirect_imports = True
ignore_imports =
    tlkernel.** -> msgspec

[importlinter:contract:layers-no-skips]
name = cli and hook never import domain or adapters
type = forbidden
source_modules =
    taskloop.cli
    taskloop.hook
forbidden_modules =
    taskloop.domain
    taskloop.adapters
allow_indirect_imports = True

[importlinter:contract:stores-not-domain]
name = stores never imports domain
type = forbidden
source_modules = taskloop.stores
forbidden_modules = taskloop.domain
allow_indirect_imports = True

[importlinter:contract:only-launch-imports-dash]
name = only app/launch (the verbs that start the dashboard) imports tldash
type = forbidden
source_modules = taskloop
forbidden_modules = tldash
allow_indirect_imports = True
ignore_imports =
    taskloop.app.launch.** -> tldash.**

[importlinter:contract:app-slices-acyclic]
name = app slices form no cycle (a layers order, top may import below)
type = layers
containers = taskloop.app
# The shared release builder is a root below wire/run; the other launch roots stay above them.
# Colon keeps imports between the other launch modules allowed, as the former launch layer did.
layers =
    launch.check : launch.check_host : launch.dash : launch.dash_ports : launch.factory : launch.lanes : launch.loop : launch.loop_ops : launch.loop_start : launch.push_judge : launch.reindex : launch.repos : launch.selftest : launch.setup_ports : launch.staged
    prune
    run
    wire
    launch.release_host
    loop
    land
    report
    reconcile
    checks
    track | doctor

# Direct slice imports are checked by tests/rules/arch_invariants.py's allow-table.

[importlinter:contract:app-cli-spawn-through-the-spawner]
name = app and cli start and signal a process only through the Spawner (adapters.procs and stream_proc are for adapters)
type = forbidden
source_modules =
    taskloop.app
    taskloop.cli
forbidden_modules =
    taskloop.adapters.procs
    stream_proc
allow_indirect_imports = True

[importlinter:contract:delegate-layers]
name = Delegate layers: api > cli > app > adapters > domain > contracts
type = layers
layers =
    delegate.api
    delegate.cli
    delegate.app
    delegate.adapters
    delegate.domain
    delegate.contracts

[importlinter:contract:delegate-is-its-own-piece]
name = delegate imports nothing of taskloop
type = forbidden
source_modules = delegate
forbidden_modules =
    taskloop
    tldash
allow_indirect_imports = True

[importlinter:contract:taskloop-does-not-import-delegate]
name = taskloop and tldash import only delegate.api of delegate
type = forbidden
source_modules =
    taskloop
    tldash
forbidden_modules =
    delegate.app
    delegate.cli
    delegate.adapters
    delegate.domain
    delegate.contracts
    delegate.entry
allow_indirect_imports = True

[importlinter:contract:package-artifacts-imports-only-the-kernel]
name = The artifacts package (tlartifacts) imports the kernel and third parties, never the tree or another package
type = forbidden
source_modules =
    tlartifacts
forbidden_modules =
    taskloop
    tldash
    delegate
allow_indirect_imports = True

[importlinter:contract:package-gate-imports-only-the-kernel]
name = The gate package (tlgate) imports the kernel and third parties, never the tree or another package
type = forbidden
source_modules =
    tlgate
forbidden_modules =
    taskloop
    tldash
    delegate
allow_indirect_imports = True

[importlinter:contract:package-work-imports-only-the-kernel]
name = The work package (tlwork) imports the kernel, the gate package and third parties, never the tree
type = forbidden
source_modules =
    tlwork
forbidden_modules =
    taskloop
    tldash
    delegate
allow_indirect_imports = True

[importlinter:contract:package-release-imports-only-kernel-and-gate]
name = tlrelease imports the kernel, gate and third parties only
type = forbidden
source_modules =
    tlrelease
forbidden_modules =
    taskloop
    tldash
    delegate
allow_indirect_imports = True

[importlinter:contract:package-slots-imports-only-the-kernel]
name = tlslots imports the kernel and third parties only
type = forbidden
source_modules =
    tlslots
forbidden_modules =
    taskloop
    tldash
    delegate
allow_indirect_imports = True

[importlinter:contract:package-asks-imports-only-the-kernel]
name = tlasks imports the kernel and third parties only
type = forbidden
source_modules =
    tlasks
forbidden_modules =
    taskloop
    tldash
    delegate
allow_indirect_imports = True

[importlinter:contract:package-pipeline-imports-only-the-kernel]
name = The pipeline package (tlpipeline) imports the kernel and third parties, never the tree or another package
type = forbidden
source_modules =
    tlpipeline
forbidden_modules =
    taskloop
    tldash
    delegate
allow_indirect_imports = True

[importlinter:contract:nobody-imports-a-root]
name = Nobody imports a root: nodes, run's logic modules and the layers below never import launch, wire or run's composition files
type = forbidden
source_modules =
    taskloop.app.checks
    taskloop.app.doctor
    taskloop.app.land
    tlwork.look
    taskloop.app.loop
    tlwork.plan
    taskloop.app.prune
    taskloop.app.reconcile
    tlrelease
    tlwork.review
    taskloop.app.report
    tlslots
    tlasks
    taskloop.app.track
    taskloop.app.workers
    tlwork.write
    taskloop.stores
    taskloop.domain
    taskloop.adapters
    tlkernel
forbidden_modules =
    taskloop.app.launch
    taskloop.app.run.bead_env
    taskloop.app.run.closer_ports
    taskloop.app.run.context
    taskloop.app.run.engine
    taskloop.app.run.entry
    taskloop.app.run.facts
    taskloop.app.run.field_ports
    taskloop.app.run.fields
    taskloop.app.run.host
    taskloop.app.run.parts_land
    taskloop.app.run.parts_plan
    taskloop.app.run.parts_run
    taskloop.app.run.plumbing
    taskloop.app.run.preflight
    taskloop.app.run.reload_ports
    taskloop.app.run.run_once
    taskloop.app.run.running
    taskloop.app.run.sections
    taskloop.app.run.stages
    taskloop.app.run.state
    taskloop.app.wire
allow_indirect_imports = True

[importlinter:contract:converted-stages-take-no-host]
name = A converted stage imports no host (not the Engine, run, wire or launch)
type = forbidden
source_modules =
    tlartifacts
    tlgate
    tlwork
    tlpipeline
    taskloop.app.checks
    taskloop.app.doctor
    taskloop.app.loop
    tlwork.plan
    taskloop.app.reconcile
    tlrelease
forbidden_modules =
    taskloop.app.run
    taskloop.app.wire
    taskloop.app.launch
allow_indirect_imports = True

[importlinter:contract:delegate-adapter-behind-stores]
name = only stores.delegate imports the delegate adapter (adapters.delegate, adapters.runner)
type = forbidden
source_modules =
    taskloop.app
    taskloop.cli
    taskloop.hook
    taskloop.domain
    tlkernel
forbidden_modules =
    taskloop.adapters.delegate
    taskloop.adapters.runner
allow_indirect_imports = True

[importlinter:contract:work-imports-no-stage]
name = domain/work reaches no stage
type = forbidden
source_modules = tlwork.work
forbidden_modules =
    taskloop.app
    tlwork.plan
    tlwork.review
    tlwork.write
    tlwork.look
    tlasks
    taskloop.domain.land
allow_indirect_imports = True

[importlinter:contract:package-dash-imports-only-the-kernel]
name = The dash package imports the kernel, third parties and delegate.api (its console reader), never the tree or a package
type = forbidden
source_modules = tldash
forbidden_modules =
    taskloop
    delegate
    tlartifacts
    tlgate
    tlpipeline
    tlslots
    tlasks
allow_indirect_imports = True
ignore_imports =
    tldash.readers.logs -> delegate.api

[importlinter:contract:release-read-side]
name = Release readers never reach the release host or gate
type = forbidden
source_modules =
    tlrelease.pins
    tlrelease.catalog
    tlrelease.manifest
    tlrelease.reexec
    tlrelease.shell
    tlrelease.paths
    tlrelease.tidy
    tlrelease.versions
forbidden_modules =
    tlrelease.host
    tlgate
