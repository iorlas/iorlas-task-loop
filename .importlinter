[importlinter]
root_packages =
    taskloop
    process_lock
    urllib
    http
    multiprocessing
include_external_packages = True

[importlinter:contract:entry-depends-on-cli]
name = The module entry delegates to the CLI; the CLI delegates to the plan surface; neither imports upward
type = layers
layers =
    taskloop.__main__
    taskloop.cli
    taskloop.cli_plan
    taskloop.cli_composition

[importlinter:contract:cli-never-imports-the-attempt-entry]
name = The command surface, its operations, their JSON shape and the machine config never import the attempt entry process
type = forbidden
source_modules =
    taskloop.cli
    taskloop.cli_plan
    taskloop.cli_composition
    taskloop.plan_ops
    taskloop.plan_next
    taskloop.selection
    taskloop.plan_data
    taskloop.machine_config
forbidden_modules =
    taskloop.attempt_entry

[importlinter:contract:entry-never-imports-the-command-surface]
name = The attempt entry process imports no command surface, operations or machine config (its import closure stays small)
type = forbidden
source_modules =
    taskloop.attempt_entry
    taskloop.composition
forbidden_modules =
    taskloop.cli
    taskloop.cli_plan
    taskloop.cli_composition
    taskloop.plan_ops
    taskloop.plan_next
    taskloop.plan_data
    taskloop.machine_config

[importlinter:contract:no-runtime-mechanisms]
name = The foundation has no direct network or process mechanisms
type = forbidden
source_modules = taskloop
forbidden_modules =
    urllib
    http
    multiprocessing
allow_indirect_imports = True

[importlinter:contract:one-slot-lock-owner]
name = Only the slot custody module imports the process lock library
type = forbidden
source_modules = taskloop
forbidden_modules = process_lock
ignore_imports =
    taskloop.slot_lock -> process_lock
