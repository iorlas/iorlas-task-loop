# The architecture rules (was tests/gate_rules.py layer_problems / placement_problems and the contracts and ports rule files).
# Run by `just rules` with src/ on PYTHONPATH. stdlib modules that are one file (subprocess, socket, threading) cannot be root packages
# here (urllib, http, multiprocessing, re are packages): their ban is ruff TID251 (src/taskloop/contracts/ruff.toml, src/taskloop/stores/ruff.toml). "delegate" is banned by TID251 in ruff.toml.
[importlinter]
root_packages =
    taskloop
    delegate
    taskloop_dash
    msgspec
    re
    urllib
    http
    multiprocessing
    stream_proc
include_external_packages = True

[importlinter:contract:layers]
name = Layers: cli/hook > app > stores > domain/adapters > contracts
type = layers
layers =
    taskloop.cli | taskloop.hook
    taskloop.app
    taskloop.stores
    taskloop.domain | taskloop.adapters
    taskloop.contracts

[importlinter:contract:forbidden-regex]
name = import re only in adapters and domain matchers
type = forbidden
source_modules =
    taskloop
    taskloop_dash
    delegate
forbidden_modules = re
allow_indirect_imports = True
ignore_imports =
    taskloop.adapters.** -> re
    taskloop.domain.**.matchers -> re
    taskloop.domain.matchers -> re
    delegate.domain.**.matchers -> re

[importlinter:contract:contracts-no-network-or-processes]
name = contracts never imports urllib, http or multiprocessing
type = forbidden
source_modules = taskloop.contracts
forbidden_modules =
    urllib
    http
    multiprocessing
allow_indirect_imports = True

[importlinter:contract:hot-hook-path-is-light]
name = the PreToolUse and git pre-push hooks import no msgspec and no record model
type = forbidden
source_modules =
    taskloop.hook.main
    taskloop.hook.pretool
    taskloop.hook.rules
    taskloop.hook.prepush
forbidden_modules =
    msgspec
    taskloop.contracts
    taskloop.app
    taskloop.adapters
    taskloop.stores
    taskloop.domain

[importlinter:contract:msgspec-in-contracts-only]
name = only taskloop.contracts imports msgspec
type = forbidden
source_modules =
    taskloop
    taskloop_dash
forbidden_modules = msgspec
allow_indirect_imports = True
ignore_imports =
    taskloop.contracts.** -> msgspec

[importlinter:contract:layers-no-skips]
name = cli and hook never import domain or adapters
type = forbidden
source_modules =
    taskloop.cli
    taskloop.hook
forbidden_modules =
    taskloop.domain
    taskloop.adapters
allow_indirect_imports = True

[importlinter:contract:stores-not-domain]
name = stores never imports domain
type = forbidden
source_modules = taskloop.stores
forbidden_modules = taskloop.domain
allow_indirect_imports = True

[importlinter:contract:dash-imports-contracts-only]
name = the dashboard imports taskloop.contracts only
type = forbidden
source_modules = taskloop_dash
forbidden_modules =
    taskloop.domain
    taskloop.adapters
    taskloop.stores
    taskloop.app
    taskloop.cli
    taskloop.hook
allow_indirect_imports = True

[importlinter:contract:only-launch-imports-dash]
name = only app/launch (the verbs that start the dashboard) imports taskloop_dash
type = forbidden
source_modules = taskloop
forbidden_modules = taskloop_dash
allow_indirect_imports = True
ignore_imports =
    taskloop.app.launch.** -> taskloop_dash.**

[importlinter:contract:app-slices-acyclic]
name = app slices form no cycle (a layers order, top may import below)
type = layers
containers = taskloop.app
layers =
    launch
    prune
    run
    wire
    loop
    land
    write | review | plan | look
    report
    reconcile
    release
    checks
    track | doctor | artifacts
    slots
    asks

# Direct slice imports are checked by tests/rules/arch_invariants.py's allow-table.

[importlinter:contract:app-cli-spawn-through-the-spawner]
name = app and cli start and signal a process only through the Spawner (adapters.procs and stream_proc are for adapters)
type = forbidden
source_modules =
    taskloop.app
    taskloop.cli
forbidden_modules =
    taskloop.adapters.procs
    stream_proc
allow_indirect_imports = True

[importlinter:contract:delegate-layers]
name = Delegate layers: api > cli > app > adapters > domain > contracts
type = layers
layers =
    delegate.api
    delegate.cli
    delegate.app
    delegate.adapters
    delegate.domain
    delegate.contracts

[importlinter:contract:delegate-is-its-own-piece]
name = delegate imports nothing of taskloop
type = forbidden
source_modules = delegate
forbidden_modules =
    taskloop
    taskloop_dash
allow_indirect_imports = True

[importlinter:contract:taskloop-does-not-import-delegate]
name = taskloop and taskloop_dash import only delegate.api of delegate
type = forbidden
source_modules =
    taskloop
    taskloop_dash
forbidden_modules =
    delegate.app
    delegate.cli
    delegate.adapters
    delegate.domain
    delegate.contracts
    delegate.entry
allow_indirect_imports = True

[importlinter:contract:nobody-imports-a-root]
name = Nobody imports a root: nodes, run's logic modules and the layers below never import launch, wire or run's composition files
type = forbidden
source_modules =
    taskloop.app.artifacts
    taskloop.app.asks
    taskloop.app.checks
    taskloop.app.doctor
    taskloop.app.land
    taskloop.app.look
    taskloop.app.loop
    taskloop.app.pipeline
    taskloop.app.plan
    taskloop.app.prune
    taskloop.app.reconcile
    taskloop.app.release
    taskloop.app.review
    taskloop.app.report
    taskloop.app.review
    taskloop.app.slots
    taskloop.app.track
    taskloop.app.workers
    taskloop.app.write
    taskloop.app.run.ask_flow
    taskloop.app.run.bead_env
    taskloop.app.run.blocked
    taskloop.app.pipeline.budget
    taskloop.app.run.closer
    taskloop.app.run.closer_branch
    taskloop.app.run.closer_decide
    taskloop.app.run.closer_host
    taskloop.app.run.closer_notes
    taskloop.app.run.closer_record
    taskloop.app.run.closer_settle
    taskloop.app.run.console
    taskloop.app.run.crash
    taskloop.app.pipeline.decide
    taskloop.app.pipeline.ended
    taskloop.app.pipeline.finish
    taskloop.app.pipeline.outcomes
    taskloop.app.run.preflight
    taskloop.app.run.records
    taskloop.app.run.reflect
    taskloop.app.run.reflect_prompt
    taskloop.app.run.reload
    taskloop.app.run.requests
    taskloop.app.run.resume
    taskloop.app.run.review_glue
    taskloop.app.run.running
    taskloop.app.run.shared
    taskloop.app.run.shell
    taskloop.app.run.stage_checks
    taskloop.app.run.stage_rounds
    taskloop.app.run.stage_run
    taskloop.app.run.stages
    taskloop.app.run.state
    taskloop.app.pipeline.steps
    taskloop.app.run.stuck
    taskloop.app.pipeline.summaries
    taskloop.app.run.target
    taskloop.app.pipeline.trace
    taskloop.app.run.waits
    taskloop.stores
    taskloop.domain
    taskloop.adapters
    taskloop.contracts
forbidden_modules =
    taskloop.app.launch
    taskloop.app.wire
    taskloop.app.run.context
    taskloop.app.run.engine
    taskloop.app.run.entry
    taskloop.app.run.fields
    taskloop.app.run.host
    taskloop.app.run.layout
    taskloop.app.run.facts
    taskloop.app.run.parts_land
    taskloop.app.run.parts_plan
    taskloop.app.run.parts_run
    taskloop.app.run.plumbing
    taskloop.app.run.run_once
allow_indirect_imports = True
ignore_imports =
    # The baseline (tl-e5t0.30): edges that exist today. The contract fails on a new one; each removal shrinks this list, never grows it.
    taskloop.app.run.crash -> taskloop.app.run.host
    taskloop.app.run.stage_rounds -> taskloop.app.run.host
    taskloop.app.run.stages -> taskloop.app.run.host
    taskloop.app.prune.runs -> taskloop.app.run.layout
    taskloop.app.run.ask_flow -> taskloop.app.run.layout
    taskloop.app.run.preflight -> taskloop.app.run.layout
    taskloop.app.run.records -> taskloop.app.run.layout
    taskloop.app.run.stages -> taskloop.app.run.layout
    taskloop.app.run.stages -> taskloop.app.run.run_once
    taskloop.app.run.closer_branch -> taskloop.app.wire.slots
    taskloop.app.run.closer_settle -> taskloop.app.wire.closeguard
    taskloop.app.run.preflight -> taskloop.app.wire.closeguard
    taskloop.app.run.running -> taskloop.app.wire.slots
    taskloop.app.run.stages -> taskloop.app.wire.closeguard

[importlinter:contract:converted-stages-take-no-host]
name = A converted stage imports no host (not the Engine, run, wire or launch)
type = forbidden
source_modules =
    taskloop.app.artifacts
    taskloop.app.checks
    taskloop.app.doctor
    taskloop.app.loop
    taskloop.app.pipeline
    taskloop.app.plan
    taskloop.app.reconcile
    taskloop.app.release
    taskloop.app.review
forbidden_modules =
    taskloop.app.run
    taskloop.app.wire
    taskloop.app.launch
allow_indirect_imports = True

[importlinter:contract:delegate-adapter-behind-stores]
name = only stores.delegate imports the delegate adapter (adapters.delegate, adapters.runner)
type = forbidden
source_modules =
    taskloop.app
    taskloop.cli
    taskloop.hook
    taskloop.domain
    taskloop.contracts
forbidden_modules =
    taskloop.adapters.delegate
    taskloop.adapters.runner
allow_indirect_imports = True

[importlinter:contract:pipeline-imports-no-stage]
name = The pipeline node reaches a stage only through its ports (docs/design/pipeline-node.md)
type = forbidden
source_modules =
    taskloop.app.pipeline
forbidden_modules =
    taskloop.app.asks
    taskloop.app.land
    taskloop.app.look
    taskloop.app.plan
    taskloop.app.prune
    taskloop.app.release
    taskloop.app.report
    taskloop.app.review
    taskloop.app.slots
    taskloop.app.track
    taskloop.app.write
allow_indirect_imports = True
