[importlinter]
root_packages =
    taskloop
    process_lock
    urllib
    http
    multiprocessing
include_external_packages = True
exclude_type_checking_imports = False

[importlinter:contract:main-depends-on-cli]
name = The `tl` module entry (`__main__`) delegates to the CLI; the CLI delegates to the step surface; neither imports upward
type = layers
layers =
    taskloop.__main__
    taskloop.cli
    taskloop.cli_step
    taskloop.cli_composition

[importlinter:contract:cli-never-imports-the-attempt-entry]
name = The command surface, its operations, their JSON shape, the machine config and the shared validation never import an entry process (agent or checks)
type = forbidden
source_modules =
    taskloop.cli
    taskloop.cli_step
    taskloop.cli_composition
    taskloop.exit_codes
    taskloop.step_guide
    taskloop.step_render
    taskloop.show_render
    taskloop.operations
    taskloop.attempt_status
    taskloop.round
    taskloop.round_log
    taskloop.round_land
    taskloop.land_mode
    taskloop.selection
    taskloop.result_data
    taskloop.machine_config
    taskloop.rounds
    taskloop.rounds_lock
    taskloop.interrupts
    taskloop.validate
    taskloop.land
    taskloop.land_check
    taskloop.land_push
    taskloop.land_close
    taskloop.land_summary
    taskloop.land_status
    taskloop.land_guide
    taskloop.land_render
    taskloop.land_data
    taskloop.hold
    taskloop.hold_status
    taskloop.hold_facts
    taskloop.hold_guide
    taskloop.task_status
forbidden_modules =
    taskloop.attempt_entry
    taskloop.check_entry

[importlinter:contract:entries-never-land]
name = The step operations, both entry processes and the wiring they import never import the land (only the command surface and a round's land phase, `round_land`, run it, wired in `cli_composition`)
type = forbidden
source_modules =
    taskloop.operations
    taskloop.attempt_entry
    taskloop.check_entry
    taskloop.composition
    taskloop.validate
    taskloop.check_release
    taskloop.land_store
    taskloop.hold_store
    taskloop.hold_text
    taskloop.hold
    taskloop.hold_status
    taskloop.hold_facts
    taskloop.task_status
forbidden_modules =
    taskloop.land
    taskloop.land_check
    taskloop.land_push
    taskloop.land_close
    taskloop.land_summary

[importlinter:contract:entry-never-imports-the-command-surface]
name = The attempt and checks entry processes import no command surface, operations or machine config (their import closure stays small)
type = forbidden
source_modules =
    taskloop.attempt_entry
    taskloop.check_entry
    taskloop.validate
    taskloop.check_release
    taskloop.check_store
    taskloop.check_admit
    taskloop.check_status
    taskloop.composition
    taskloop.git_views
    taskloop.agent_credentials
    taskloop.owned_processes
    taskloop.slot_files
    taskloop.tracker_client
    taskloop.slot_env
    taskloop.access
    taskloop.checks
forbidden_modules =
    taskloop.cli
    taskloop.cli_step
    taskloop.cli_composition
    taskloop.exit_codes
    taskloop.step_guide
    taskloop.step_render
    taskloop.show_render
    taskloop.operations
    taskloop.attempt_status
    taskloop.round
    taskloop.result_data
    taskloop.machine_config
    taskloop.rounds
    taskloop.interrupts
    taskloop.land_render
    taskloop.land_data

[importlinter:contract:no-runtime-mechanisms]
name = The foundation has no direct network or process mechanisms
type = forbidden
source_modules = taskloop
forbidden_modules =
    urllib
    http
    multiprocessing
allow_indirect_imports = True
unmatched_ignore_alerting = error
ignore_imports =
    taskloop.dash_server -> http.server
    taskloop.shelf_digest.identities -> urllib.parse

[importlinter:contract:process-lock-owners]
name = Only slot custody and the rounds lock import the process lock library
type = forbidden
source_modules = taskloop
forbidden_modules = process_lock
unmatched_ignore_alerting = error
ignore_imports =
    taskloop.slot_lock -> process_lock
    taskloop.rounds_lock -> process_lock

[importlinter:contract:one-signal-owner]
name = Only the rounds process's SIGINT, SIGTERM and SIGHUP handlers import signal
type = forbidden
source_modules = taskloop
forbidden_modules = signal
unmatched_ignore_alerting = error
ignore_imports =
    taskloop.interrupts -> signal

[importlinter:contract:one-step-kind-owner]
name = Only the step kinds (`steps`) import a step kind's own module; the machinery reaches each through `steps.kind`
type = protected
protected_modules =
    taskloop.plan_step
    taskloop.implement_step
allowed_importers = taskloop.steps

[importlinter:contract:profile-is-domain]
name = The repository profile reader is domain: no command surface, composition (or the real ports it wires), store or Git library (Git enters through its port)
type = forbidden
source_modules = taskloop.profile
forbidden_modules =
    taskloop.cli
    taskloop.cli_step
    taskloop.cli_composition
    taskloop.composition
    taskloop.git_views
    taskloop.agent_credentials
    taskloop.owned_processes
    taskloop.slot_files
    taskloop.tracker_client
    taskloop.exit_codes
    taskloop.step_render
    taskloop.result_data
    taskloop.operations
    taskloop.attempt_entry
    git_porcelain
    sqlite_store
    beads_client

# BEGIN GENERATED FOLDER CONTRACTS

