# The suite image: python 3.12 plus what the tests shell out to (git, make, ps/pgrep, lsof). Built by dev/suite-docker.py.
FROM python:3.12-slim
RUN apt-get update -qq \
 && apt-get install -y -qq --no-install-recommends git make procps lsof ca-certificates \
 && rm -rf /var/lib/apt/lists/* \
 && git config --system --add safe.directory '*' \
 && git config --system user.name t && git config --system user.email t@t \
 && git config --system init.defaultBranch main
